<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash: the Ludo Lux mark on the game's own dark teal, straight into the menu. -->
    <style name="LuxTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lux_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/lux_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
