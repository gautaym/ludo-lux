# Copy to deploy/.env on the server and fill in. Never commit the real .env.
DOMAIN=play.example.in
PUBLIC_URL=https://play.example.in
TURN_SECONDS=45
# Google sign-in: the OAuth *web* client id (same one the app is built with).
GOOGLE_CLIENT_IDS=632622233321-16k1sm51356ee5ekgjf15bvl4hh83aii.apps.googleusercontent.com
# Purchases: google = real Google Play checks; leave test modes OFF on a public server.
BILLING_MODE=google
PLAY_PACKAGE=com.ludolux.kmp
PLAY_SERVICE_ACCOUNT=/secrets/play-service-account.json
# Backups (restic). Any S3-compatible bucket works, e.g. Backblaze B2 or Cloudflare R2.
RESTIC_REPOSITORY=s3:https://s3.example.com/ludolux-backups
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
