# HTTPS is automatic. WebSockets (/v1/play) pass straight through.
{$DOMAIN} {
	encode gzip
	# Monitoring numbers stay private (read them on the server: curl localhost via docker exec).
	@private path /metrics
	respond @private 404
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy ludolux:8080
}
