# HTTPS is automatic. WebSockets (/v1/play) pass straight through.
{$DOMAIN} {
	encode gzip
	# Monitoring numbers and the ads review page stay private: open them through an SSH tunnel (see RUNBOOK.md).
	@private path /metrics /admin /admin/* /v1/admin/*
	respond @private 404
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy ludolux:8080
}
